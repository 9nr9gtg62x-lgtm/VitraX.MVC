@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    string Nav(string name) => ctrl == name ? "vx-nav-link active" : "vx-nav-link";
}
<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - VitraX</title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5 (RTL) + Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- DataTables (Bootstrap 5 styling) -->
    <link href="https://cdn.datatables.net/1.13.11/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

    <link href="~/css/vitrax.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- ===== القائمة الجانبية ===== -->
    <aside class="vx-sidebar">
        <div class="vx-sidebar-brand">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary rounded-3 shadow" style="width:3rem;height:3rem;">
                <span class="fw-bold fs-4">V</span>
            </div>
            <h1 class="h5 fw-bold mt-2 mb-0">VitraX</h1>
            <span class="small text-white-50">Glass Production</span>
        </div>
        <nav class="flex-grow-1 d-flex flex-column gap-1">
            <a class="@Nav("Home")" href="/Home">
                <i class="bi bi-speedometer2 fs-5"></i>
                <span class="small">لوحة التحكم</span>
            </a>
            <a class="@Nav("Products")" href="/Products">
                <i class="bi bi-box-seam fs-5"></i>
                <span class="small">المنتجات</span>
            </a>
            <a class="@Nav("ProductionOrders")" href="/ProductionOrders">
                <i class="bi bi-gear-wide-connected fs-5"></i>
                <span class="small">أوامر الإنتاج</span>
            </a>
            <a class="@Nav("Workers")" href="/Workers">
                <i class="bi bi-person-workspace fs-5"></i>
                <span class="small">العمال</span>
            </a>
            <a class="@Nav("ProductionTasks")" href="/ProductionTasks">
                <i class="bi bi-clipboard-check fs-5"></i>
                <span class="small">المهام</span>
            </a>
        </nav>
        <div class="px-3">
            <a class="vx-nav-link px-3" href="/Account/Logout">
                <i class="bi bi-box-arrow-left fs-5"></i>
                <span class="small">تسجيل الخروج</span>
            </a>
        </div>
    </aside>

    <!-- ===== المحتوى الرئيسي ===== -->
    <div class="vx-main">
        <header class="vx-topbar d-flex justify-content-between align-items-center px-4" style="height:64px;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-search text-muted"></i>
                <input class="form-control form-control-sm border-0 bg-light" style="width:220px;" placeholder="بحث..." type="text" />
            </div>
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-light btn-sm rounded-circle position-relative" title="الإشعارات">
                    <i class="bi bi-bell text-primary"></i>
                    <span class="position-absolute top-0 start-0 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                </button>
                <div class="d-flex align-items-center gap-2 border-end pe-3 me-1">
                    <div class="text-end">
                        <p class="small fw-bold mb-0 lh-1">مدير المصنع</p>
                        <p class="mb-0" style="font-size:10px;color:var(--vx-on-surface-variant);">Admin</p>
                    </div>
                    <div class="rounded-circle border border-2 border-primary bg-primary bg-opacity-10 d-flex align-items-center justify-content-center text-primary" style="width:2.5rem;height:2.5rem;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                </div>
            </div>
        </header>

        @RenderBody()

        <footer class="mt-auto border-top bg-white py-4 px-4">
            <div class="d-flex flex-column flex-md-row-reverse justify-content-between align-items-center gap-2">
                <div class="text-end">
                    <p class="fw-bold text-primary small mb-0">VitraX Industrial Solutions</p>
                    <p class="small text-muted mb-0">© 2026 جميع الحقوق محفوظة لمصنع فيتراكس للزجاج</p>
                </div>
                <div class="d-flex gap-3 small text-muted">
                    <a class="text-muted text-decoration-none" href="#">الخصوصية</a>
                    <a class="text-muted text-decoration-none" href="#">الشروط</a>
                    <a class="text-muted text-decoration-none" href="#">الدعم</a>
                </div>
            </div>
        </footer>
    </div>

    <!-- Bootstrap bundle (incl. Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery + DataTables -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.11/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.11/js/dataTables.bootstrap5.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.chart-bar').forEach((bar, index) => {
                const targetHeight = bar.style.height;
                bar.style.height = '0';
                setTimeout(() => { bar.style.height = targetHeight; }, 100 * index);
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
