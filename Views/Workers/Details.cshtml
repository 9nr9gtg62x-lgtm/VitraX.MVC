@model VitraX.Domain.Entities.Worker
@{
    ViewData["Title"] = "تفاصيل العامل";
    Layout = "_Layout";
}

<div class="p-4">
    <div class="mx-auto" style="max-width:48rem;">
        <div class="d-flex align-items-center gap-3 mb-3">
            <a href="/Workers" class="btn btn-light btn-sm rounded-3"><i class="bi bi-arrow-right"></i></a>
            <div class="text-end flex-fill">
                <h2 class="fw-bold text-primary mb-0">تفاصيل العامل</h2>
                <p class="text-muted small mb-0">عرض بيانات العامل</p>
            </div>
        </div>

        <div class="glass-card rounded-4 overflow-hidden">
            <div class="p-4 d-flex align-items-center gap-3 text-white" style="background:var(--vx-navy);">
                <div class="vx-thumb vx-thumb-round" style="width:5rem;height:5rem;background:rgba(255,255,255,.15);color:var(--vx-secondary-fixed);font-size:2rem;border:2px solid rgba(113,248,228,.3);">
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath" alt="@Model.WorkerName" />
                    }
                    else
                    {
                        <i class="bi bi-person-fill"></i>
                    }
                </div>
                <div class="text-end flex-fill">
                    <h3 class="fw-bold mb-0">@Model.WorkerName</h3>
                    <p class="mb-0" style="color:var(--vx-secondary-fixed);opacity:.7;">@Model.Role</p>
                </div>
            </div>

            <div class="p-4 row g-3 text-end">
                <div class="col-md-6">
                    <p class="text-muted small mb-1">الدور</p>
                    <p class="fw-bold mb-0">@Model.Role</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted small mb-1">الهاتف</p>
                    <p class="fw-bold font-en mb-0">@Model.Phone</p>
                </div>
            </div>

            <div class="px-4 py-3 border-top d-flex gap-2">
                <a href="/Workers/Edit/@Model.WorkerId" class="btn btn-primary d-flex align-items-center gap-2 px-4">
                    <i class="bi bi-pencil"></i> تعديل
                </a>
                <a href="/Workers/Delete/@Model.WorkerId" class="btn btn-outline-danger px-4">حذف</a>
                <a href="/Workers" class="btn btn-light px-4 ms-auto">رجوع</a>
            </div>
        </div>
    </div>
</div>
