@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = null;
}
<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>VitraX | تسجيل الدخول</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/vitrax.css" rel="stylesheet" asp-append-version="true" />
    <style>
        body { min-height: 100vh; display: flex; align-items: center; justify-content: center; position: relative; }
    </style>
</head>
<body>
    <div class="vx-auth-pattern"></div>

    <main class="position-relative w-100 px-3" style="max-width:28rem;z-index:1;">
        <div class="glass-card rounded-4 p-4 p-md-5">
            <div class="d-flex flex-column align-items-center mb-4">
                <div class="d-flex align-items-center justify-content-center bg-primary rounded-3 mb-3 shadow" style="width:4rem;height:4rem;">
                    <i class="bi bi-gear-wide-connected text-white fs-2"></i>
                </div>
                <h1 class="h4 fw-bold mb-1">VitraX</h1>
                <p class="small text-muted">Glass Production Excellence</p>
            </div>

            <div class="mb-4 text-center">
                <h2 class="h5 fw-bold text-primary">تسجيل الدخول | Login</h2>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success d-flex align-items-center gap-2 small" role="alert">
                    <i class="bi bi-check-circle"></i> @TempData["Success"]
                </div>
            }
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 small" role="alert">
                    <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post" class="d-flex flex-column gap-3">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div>
                    <label class="form-label small text-muted">اسم المستخدم | Username</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                        <input name="username" type="text" required class="form-control" placeholder="admin" />
                    </div>
                </div>

                <div>
                    <label class="form-label small text-muted">كلمة المرور | Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-lock"></i></span>
                        <input name="password" id="passwordField" type="password" required class="form-control" placeholder="••••••••" />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePassword()">
                            <i class="bi bi-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="rememberMe" value="true" id="rememberMe" />
                    <label class="form-check-label small text-muted" for="rememberMe">تذكرني</label>
                </div>

                <button type="submit" class="btn btn-primary btn-lg d-flex align-items-center justify-content-center gap-2">
                    <span>تسجيل الدخول</span>
                    <i class="bi bi-box-arrow-in-right"></i>
                </button>
            </form>

            <div class="mt-4 pt-3 border-top text-center">
                <p class="small text-muted mb-0">
                    ليس لديك حساب؟
                    <a class="fw-bold text-decoration-none" asp-controller="Account" asp-action="Register">إنشاء حساب جديد</a>
                </p>
            </div>
        </div>

        <footer class="mt-4 text-center">
            <p class="small text-muted">© 2026 VitraX Industrial Solutions</p>
        </footer>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePassword() {
            const f = document.getElementById('passwordField');
            const icon = document.getElementById('eyeIcon');
            if (f.type === 'password') { f.type = 'text'; icon.className = 'bi bi-eye-slash'; }
            else { f.type = 'password'; icon.className = 'bi bi-eye'; }
        }
    </script>
</body>
</html>
