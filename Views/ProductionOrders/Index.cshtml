@model IEnumerable<VitraX.Domain.Entities.ProductionOrder>
@{
    ViewData["Title"] = "أوامر الإنتاج";
    Layout = "_Layout";
    string StatusClass(string s) => s switch
    {
        "مكتمل" => "vx-badge-complete",
        "متوقف" => "vx-badge-stopped",
        _ => "vx-badge-progress"
    };
}

<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="/ProductionOrders/Create" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-lg"></i> إضافة أمر إنتاج
        </a>
        <div class="text-end">
            <h2 class="fw-bold text-primary mb-0">أوامر الإنتاج</h2>
            <p class="text-muted small mb-0">إدارة أوامر إنتاج الزجاج</p>
        </div>
    </div>

    <div class="glass-card rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table id="ordersTable" class="table table-hover align-middle mb-0 text-end">
                <thead>
                    <tr>
                        <th>رقم الأمر</th>
                        <th>المنتج</th>
                        <th>الكمية</th>
                        <th>الحالة</th>
                        <th>تاريخ البدء</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="font-en">#@item.OrderId</td>
                            <td class="fw-bold">@(item.Product?.ProductName ?? "-")</td>
                            <td class="font-en">@item.Quantity</td>
                            <td><span class="vx-badge @StatusClass(item.Status)">@item.Status</span></td>
                            <td class="font-en">@item.StartDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <div class="d-flex align-items-center gap-1 justify-content-end">
                                    <a href="/ProductionOrders/Details/@item.OrderId" class="btn btn-sm p-2 text-primary" title="تفاصيل"><i class="bi bi-eye"></i></a>
                                    <a href="/ProductionOrders/Edit/@item.OrderId" class="btn btn-sm p-2 text-secondary" title="تعديل"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="btn btn-sm p-2 text-danger" data-bs-toggle="modal" data-bs-target="#deleteModal"
                                            data-id="@item.OrderId" data-name="@("#" + item.OrderId)" title="حذف">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">
            <form asp-action="Delete" method="post">
                <input type="hidden" name="id" id="deleteItemId" />
                <div class="modal-body text-center p-4">
                    <div class="vx-icon-tile mx-auto mb-3" style="background:rgba(var(--bs-danger-rgb),.1);color:var(--bs-danger);width:4rem;height:4rem;font-size:1.75rem;">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <h5 class="fw-bold mb-2">تأكيد الحذف</h5>
                    <p class="text-muted mb-0">
                        هل أنت متأكد من حذف أمر الإنتاج
                        <span class="fw-bold text-primary" id="deleteItemName"></span>؟<br />
                        لا يمكن التراجع عن هذا الإجراء.
                    </p>
                </div>
                <div class="modal-footer border-top-0 justify-content-center gap-2 pb-4">
                    <button type="submit" class="btn btn-danger px-4"><i class="bi bi-trash me-1"></i> نعم، احذف</button>
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('deleteModal').addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('deleteItemId').value = btn.getAttribute('data-id');
            document.getElementById('deleteItemName').textContent = btn.getAttribute('data-name');
        });
        $(function () {
            $('#ordersTable').DataTable({
                language: {
                    search: "بحث:", zeroRecords: "لا توجد نتائج",
                    info: "عرض _START_ إلى _END_ من _TOTAL_ سجل", infoEmpty: "لا توجد سجلات",
                    paginate: { previous: "السابق", next: "التالي" }
                },
                columnDefs: [{ orderable: false, targets: -1 }]
            });
        });
    </script>
}
