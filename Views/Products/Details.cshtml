@model VitraX.Domain.Entities.Product
@{
    ViewData["Title"] = "تفاصيل المنتج";
    Layout = "_Layout";
}

<div class="p-4">
    <div class="mx-auto" style="max-width:48rem;">
        <div class="d-flex align-items-center gap-3 mb-3">
            <a href="/Products" class="btn btn-light btn-sm rounded-3"><i class="bi bi-arrow-right"></i></a>
            <div class="text-end flex-fill">
                <h2 class="fw-bold text-primary mb-0">تفاصيل المنتج</h2>
                <p class="text-muted small mb-0">عرض بيانات المنتج</p>
            </div>
        </div>

        <div class="glass-card rounded-4 overflow-hidden">
            <div class="p-4 d-flex align-items-center gap-3 text-white" style="background:var(--vx-navy);">
                <div class="vx-thumb" style="width:4rem;height:4rem;background:rgba(255,255,255,.15);color:var(--vx-secondary-fixed);font-size:1.75rem;">
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath" alt="@Model.ProductName" />
                    }
                    else
                    {
                        <i class="bi bi-front"></i>
                    }
                </div>
                <div class="text-end flex-fill">
                    <h3 class="fw-bold mb-0">@Model.ProductName</h3>
                    <p class="mb-0" style="color:var(--vx-secondary-fixed);opacity:.7;">#@Model.ProductId</p>
                </div>
            </div>

            <div class="p-4 row g-3 text-end">
                <div class="col-md-6">
                    <p class="text-muted small mb-1">السماكة</p>
                    <p class="fw-bold font-en mb-0">@Model.Thickness mm</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted small mb-1">المقاس</p>
                    <p class="fw-bold mb-0">@Model.Size</p>
                </div>
                <div class="col-12">
                    <p class="text-muted small mb-1">الوصف</p>
                    <p class="mb-0">@Model.Description</p>
                </div>
            </div>

            <div class="px-4 py-3 border-top d-flex gap-2">
                <a href="/Products/Edit/@Model.ProductId" class="btn btn-primary d-flex align-items-center gap-2 px-4">
                    <i class="bi bi-pencil"></i> تعديل
                </a>
                <a href="/Products/Delete/@Model.ProductId" class="btn btn-outline-danger px-4">حذف</a>
                <a href="/Products" class="btn btn-light px-4 ms-auto">رجوع</a>
            </div>
        </div>
    </div>
</div>
