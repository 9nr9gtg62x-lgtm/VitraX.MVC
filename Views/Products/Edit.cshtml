@model VitraX.API.Entities.Product
@{
    ViewData["Title"] = "تعديل منتج";
    Layout = "_Layout";
}

<div class="p-4">
    <div class="mx-auto" style="max-width:48rem;">
        <div class="d-flex align-items-center gap-3 mb-3">
            <a href="/Products" class="btn btn-light btn-sm rounded-3"><i class="bi bi-arrow-right"></i></a>
            <div class="text-end flex-fill">
                <h2 class="fw-bold text-primary mb-0">تعديل المنتج</h2>
                <p class="text-muted small mb-0">@Model.ProductName</p>
            </div>
        </div>

        <div class="glass-card rounded-4 p-4">
            <form asp-action="Edit" method="post" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <input type="hidden" asp-for="ProductId" />

                <div class="col-md-6">
                    <label asp-for="ProductName" class="form-label fw-bold">اسم المنتج</label>
                    <input asp-for="ProductName" class="form-control" />
                    <span asp-validation-for="ProductName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Size" class="form-label fw-bold">المقاس</label>
                    <input asp-for="Size" class="form-control" />
                    <span asp-validation-for="Size" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Thickness" class="form-label fw-bold">السماكة (مم)</label>
                    <input asp-for="Thickness" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Thickness" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ImagePath" class="form-label fw-bold">رابط الصورة</label>
                    <input asp-for="ImagePath" class="form-control" />
                    <span asp-validation-for="ImagePath" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-bold">الوصف</label>
                    <textarea asp-for="Description" rows="3" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="col-12 d-flex gap-2 pt-3 border-top">
                    <button type="submit" class="btn btn-primary d-flex align-items-center gap-2 px-4">
                        <i class="bi bi-save"></i> حفظ التعديلات
                    </button>
                    <a href="/Products" class="btn btn-light px-4">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
